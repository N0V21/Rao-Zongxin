# 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# cp .env.example .env

# DeepSeek 或其他 OpenAI 兼容接口
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 可选：检索参数 ----
# HK_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# HK_TOP_K=10
# HK_SCORE_THRESHOLD=0.5
# HK_VARIANT_WEIGHT=0.9
# HK_CONTEXT_WINDOW=1
# HK_LLM_TIMEOUT=60
# HK_LLM_MAX_TOKENS=1024
